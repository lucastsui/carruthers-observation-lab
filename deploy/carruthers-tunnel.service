[Unit]
Description=Carruthers public Cloudflare Quick Tunnel
After=network-online.target carruthers.service carruthers-gateway.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
User=carruthers-tunnel
Group=carruthers-tunnel
ExecStart=/usr/bin/python3 /opt/carruthers/app/deploy/quick_tunnel.py
RuntimeDirectory=carruthers-tunnel
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Restart=always
RestartSec=15
MemoryMax=256M
CPUQuota=100%
TasksMax=64
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LogNamespace=carruthers

[Install]
WantedBy=multi-user.target
